# Copy to .env and fill in. Never commit .env.

# --- firewall process only: wallet credentials (the agent never loads these) ---
# Circle testnet API key, full format TEST_API_KEY:<id>:<secret>
TEST_API_KEY=
ENTITY_SECRET=
# Written by `npm run wallets:setup`
CIRCLE_WALLET_SET_ID=
CIRCLE_FIREWALL_WALLET_ID=
CIRCLE_FIREWALL_WALLET_ADDRESS=
# Optional: port (default 4020) and ledger path (default data/firewall.db).
# FIREWALL_ADMIN_TOKEN: any random string (openssl rand -hex 16). Required for `npm run demo:scene` and `npm run task`;
# `npm run demo` alone makes up a random one per run if it is unset, which those two commands can't know.
FIREWALL_PORT=
FIREWALL_ADMIN_TOKEN=
FIREWALL_DB=

# --- optional: onchain watchdog (QuickNode Streams), see README "Watchdog (QuickNode Streams)" ---
# The stream's security token (QuickNode signs each webhook with it). Setting it turns the watchdog on.
QUICKNODE_STREAM_TOKEN=
# Webhook port (default 4023). Tunnel THIS port only, never the firewall's 4020.
WATCHDOG_PORT=
# Only for `npm run watchdog:stream -- --create` (creates the stream); never needed at runtime.
QUICKNODE_API_KEY=
# Public URL of the webhook port, e.g. https://firewall.example.dev (the Stream's destination is this + /quicknode).
WATCHDOG_PUBLIC_URL=
# Named Cloudflare Tunnel for `npm run tunnel` (e.g. agent-firewall). Empty: a quick tunnel on a random URL.
WATCHDOG_TUNNEL=
# Only for `npm run watchdog:stream`: QuickNode's network slug for Arc testnet (default arc-testnet).
QUICKNODE_NETWORK=

# --- unsafe baseline demo only: a separate throwaway wallet with a tiny balance ---
BASELINE_PRIVATE_KEY=
BASELINE_ADDRESS=

# --- agent: the LLM key only ---
ANTHROPIC_API_KEY=
# Optional agent settings: model (default claude-sonnet-5-5), effort (low|medium|high|xhigh|max; default medium),
# turn cap (default 25), and the firewall's URL (default http://127.0.0.1:$FIREWALL_PORT, i.e. :4020).
AGENT_MODEL=
AGENT_EFFORT=
AGENT_MAX_TURNS=
FIREWALL_URL=

# --- vendors (demo stand-ins for third parties; they never load wallet credentials) ---
# Optional: ports (default 4021 honest, 4022 shady) and the shady vendor's starting mode
# The firewall reads the ports too: config/registry.json's localhost:4021 / :4022 URLs are re-pointed to them.
# (honest | overcharge | payee_swap | price_creep | slow_drain | inject; default honest)
VENDOR_HONEST_PORT=
VENDOR_SHADY_PORT=
VENDOR_SHADY_MODE=
